{
  "name": "wxqt-gdal",
  "version-string": "0",
  "description": "Minimal GDAL command-line tools for the Windows portable package and the Linux AppImage (see .github/workflows/build.yml); NetCDF-4 and /vsicurl for the models that read NetCDF by range (SPC mesoanalysis, GEOS-FP, the climatology)",
  "dependencies": [
    {
      "name": "gdal",
      "default-features": false,
      "features": [
        "tools",
        "geos",
        "png",
        "sqlite3",
        "openjpeg",
        "netcdf",
        "curl"
      ]
    },
    {
      "name": "netcdf-c",
      "default-features": false,
      "features": [
        "netcdf-4"
      ]
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    {
      "name": "proj",
      "default-features": false,
      "features": [
        "tiff"
      ]
    },
    {
      "name": "tiff",
      "default-features": false,
      "features": [
        "zip"
      ]
    },
    {
      "name": "sqlite3",
      "default-features": false,
      "features": [
        "json1",
        "rtree"
      ]
    }
  ]
}
